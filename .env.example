# Public Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Required only for drafts, seeding and authenticated server reads
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional forms integration. The API sends JSON to this endpoint.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Optional separate endpoints (override FORMS_WEBHOOK_URL)
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
MEMBERSHIP_WEBHOOK_URL=
MEDIA_REQUEST_WEBHOOK_URL=
